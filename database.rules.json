{
  "rules": {
    "users": {
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "pins": {
      "$pin": {
        ".read": true,
        ".write": "auth != null && newData.val() === auth.uid"
      }
    },
    "hackathon_demo": {
      ".read": true,
      ".write": true
    }
  }
}
