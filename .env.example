# Firebase Realtime Database — cross-device SOS sync
# 1. Go to https://console.firebase.google.com
# 2. Create project (free)
# 3. Add Web App → copy config
# 4. Realtime Database → Create → Start in TEST MODE
# 5. Copy these values and rename this file to .env
#
# VITE_FIREBASE_API_KEY enables Firebase Authentication (email/password +
# "Continue with Google"). Without it, Login/Register fall back to a local
# demo account (james@gmail.com / demo1234). To enable real auth: Firebase
# Console → Authentication → Sign-in method → enable Email/Password and Google.

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your_project
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# AI chatbot — /api/chat (Gemini via Vercel AI SDK)
# Get a free key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# AI voice replies — /api/tts (Google Cloud Text-to-Speech, supports kk/ru/en)
# 1. Go to https://console.cloud.google.com → create/select a project
# 2. Enable "Cloud Text-to-Speech API" (Library → search → Enable)
# 3. Make sure billing is enabled on the project (required by Google for
#    this API, but usage stays within the free tier — 1M Wavenet chars/month)
# 4. Credentials → Create API key → restrict it to "Cloud Text-to-Speech API"
# Without this key, voice replies fall back to the browser's built-in voice.
GOOGLE_TTS_API_KEY=your_google_cloud_tts_api_key_here
